{
  "name": "yeobaek-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "import": "tsx scripts/import-xlsx.ts",
    "prebuild": "pnpm run import && node scripts/prepare-assets.mjs",
    "build": "next build && node scripts/secure-export.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "next": "16.4.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
