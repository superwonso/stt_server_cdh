# Run from the project folder. Remote site origins must use HTTPS.
SITE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set 2-10 private IDs locally. Never commit their values.
ACCOUNT_USERNAMES=
# Set one of those IDs only in server/.env. `python -m server.manage
# configure-admin` fills this without printing it; when multiple are activated the
# interactive command asks for the ID with terminal echo disabled.
ADMIN_USERNAME=
DATA_DIR=.data
MODEL_CACHE_DIR=.models
ASR_MODEL=Qwen3-ASR-1.7B
ASR_ALIGNER=Qwen3-ForcedAligner-0.6B
# ROCm PyTorch uses CUDA-style device names.
ASR_DEVICE=cuda:0
ASR_DTYPE=bfloat16
ASR_ATTENTION=sdpa
STABILITY_GUARD_SECONDS=0.6
# start-server.sh enables warmup by default and overrides this value.
MODEL_WARMUP=1
SESSION_HOURS=24
# Maximum running + waiting audio jobs across all accounts.
MAX_PENDING_CHUNKS=2
MAX_UPLOAD_BYTES=512000
# Private recording imports: at most 1 GiB and four decoded hours.
MAX_IMPORT_BYTES=1073741824
MAX_IMPORT_SECONDS=14400
# Normalized WAV recordings use DATA_DIR as private staging, up to 20 GiB.
# With Google Drive enabled, a completed/verified upload is removed locally.
# New writes stop before the disk's free space falls below 1 GiB.
MAX_RECORDINGS_BYTES=21474836480
RECORDING_FREE_RESERVE_BYTES=1073741824

# Optional private Google Drive archive. First put the Desktop OAuth client
# JSON at .data/google-drive/oauth-client.json, run the authorization command
# documented in README, and only then enable this. OAuth files stay server-side.
GOOGLE_DRIVE_RECORDINGS=0
GOOGLE_DRIVE_OAUTH_CLIENT_FILE=.data/google-drive/oauth-client.json
GOOGLE_DRIVE_TOKEN_FILE=.data/google-drive/token.json
# Every non-final resumable-upload chunk must be a 256 KiB multiple.
GOOGLE_DRIVE_UPLOAD_CHUNK_BYTES=8388608
GOOGLE_DRIVE_CONNECT_TIMEOUT_SECONDS=10
GOOGLE_DRIVE_READ_TIMEOUT_SECONDS=60
GOOGLE_DRIVE_RETRY_MAX_SECONDS=300

# Optional NAVER Cloud CLOVA Speech live streaming. This must be the Secret
# Key from a Basic streaming/long-sentence domain, not an NCP access key. Keep
# it only in server/.env; microphone audio selected for CLOVA leaves this PC.
CLOVA_SPEECH_SECRET_KEY=
# NAVER limits one gRPC connection to five minutes, so rotate before then.
CLOVA_STREAM_RESPONSE_TIMEOUT_SECONDS=45
CLOVA_STREAM_MAX_AGE_SECONDS=240
CLOVA_STREAM_IDLE_SECONDS=45
CLOVA_EPD_GAP_MS=1500
CLOVA_EPD_DURATION_MS=15000

# Optional NOVA transcript post-processing. Keep the key only in server/.env.
MINDLOGIC_API_KEY=
MINDLOGIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
MINDLOGIC_MODEL=solar-pro4
# Optional lecture summaries use the same server-only gateway key.
SUMMARY_MODEL=solar-pro4
SUMMARY_CHUNK_CHARS=6000
SUMMARY_MAX_SOURCE_CHARS=250000
TRANSLATION_MODEL=solar-pro4
TRANSLATION_CHUNK_CHARS=6000
TRANSLATION_MAX_SOURCE_CHARS=250000
# Final transcript segments are corrected in bounded groups with neighboring
# segments supplied as read-only context. Requests retry only transient errors.
CORRECTION_CHUNK_CHARS=6000
CORRECTION_OVERLAP_SEGMENTS=2
CORRECTION_CONNECT_TIMEOUT_SECONDS=10
CORRECTION_READ_TIMEOUT_SECONDS=90
CORRECTION_MAX_RETRIES=2
CORRECTION_RETRY_BASE_SECONDS=1
CORRECTION_MAX_RESPONSE_BYTES=2097152
