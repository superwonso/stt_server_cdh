# Run from the project folder. Remote site origins must use HTTPS.
SITE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set exactly two private IDs locally. Never commit their values.
ACCOUNT_USERNAMES=
DATA_DIR=.data
MODEL_CACHE_DIR=.models
ASR_MODEL=Qwen3-ASR-1.7B
ASR_ALIGNER=Qwen3-ForcedAligner-0.6B
# ROCm PyTorch uses CUDA-style device names.
ASR_DEVICE=cuda:0
ASR_DTYPE=bfloat16
ASR_ATTENTION=sdpa
STABILITY_GUARD_SECONDS=0.6
# start-server.sh enables warmup by default and overrides this value.
MODEL_WARMUP=1
SESSION_HOURS=24
# Maximum running + waiting audio jobs across both accounts.
MAX_PENDING_CHUNKS=2
MAX_UPLOAD_BYTES=512000
# Private recording imports: at most 1 GiB and four decoded hours.
MAX_IMPORT_BYTES=1073741824
MAX_IMPORT_SECONDS=14400
